<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the macOS app bundle's Info.plist by the Tauri bundler. -->
<plist version="1.0">
<dict>
	<!-- The UI is in English and Turkish: lets AppKit show its own texts
	     (standard dialog buttons, the Services menu...) in Turkish too. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>tr</string>
	</array>
</dict>
</plist>
