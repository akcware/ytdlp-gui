{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yt-dlp GUI",
  "version": "0.2.0",
  "identifier": "com.kadir.ytdlpgui",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "yt-dlp GUI",
        "width": 900,
        "height": 720,
        "minWidth": 560,
        "minHeight": 500,
        "center": true,
        "visible": false,
        "transparent": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 28 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "akcware",
    "copyright": "Copyright (c) 2026 Aşkın Kadir Çekim",
    "license": "MIT",
    "homepage": "https://github.com/akcware/ytdlp-gui",
    "category": "Utility",
    "shortDescription": "Lightweight desktop app for yt-dlp",
    "longDescription": "A small, native-feeling Windows and macOS app for downloading video and audio with yt-dlp.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
